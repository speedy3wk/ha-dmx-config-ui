  {
    "name": "fixture checks",
    "config": {
      "artnet": {
        "universes": [
          {
            "universe": 0,
            "devices": [
              {
                "name": "a",
                "start_address": 1,
                "fixture": "RGB",
                "mode": "16 bit"
              },
              {
                "name": "b",
                "start_address": 510,
                "fixture": "RGB"
              },
              {
                "name": "c",
                "start_address": 100,
                "fixture": "Unknown Thing"
              },
              {
                "name": "d",
                "start_address": 200,
                "fixture": "Pixel Bar"
              }
            ]
          }
        ]
      }
    },
    "fixtures": [
      {
        "aliases": [
          "RGB",
          "rgb-fader",
          "RGB Fader"
        ],
        "modes": [
          {
            "key": "8bit",
            "name": "8 bit",
            "width": 3,
            "exact": true
          },
          {
            "key": "16bit",
            "name": "16 bit",
            "width": 6,
            "exact": true
          }
        ]
      },
      {
        "aliases": [
          "DeskCh",
          "desk-channel",
          "Desk Channel"
        ],
        "modes": [
          {
            "key": "8bit",
            "name": "8 bit",
            "width": 1,
            "exact": true
          }
        ]
      },
      {
        "aliases": [
          "Pixel Bar"
        ],
        "modes": [
          {
            "key": "Pixels",
            "name": "Pixels",
