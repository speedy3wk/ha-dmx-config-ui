  {
    "name": "overlap and duplicates",
    "config": {
      "artnet": {
        "universes": [
          {
            "universe": 1,
            "devices": [
              {
                "name": "a",
                "start_address": 1,
                "fixture": "RGB",
                "entity_id_prefix": "p"
              },
              {
                "name": "b",
                "start_address": 3,
                "fixture": "DeskCh",
                "entity_id_prefix": "p"
              },
              {
                "name": "a",
                "start_address": 10,
                "fixture": "DeskCh"
              }
            ]
          },
          {
            "net": 0,
            "subnet": 0,
            "universe": 1,
            "devices": []
          }
        ]
      },
      "sacn": {
        "universes": [
          {
            "universe": 1,
            "devices": [
              {
                "name": "c",
                "start_address": 1,
                "fixture": "RGB"
              }
            ]
          },
          {
            "universe": 1,
            "devices": []
          }
        ]
      }
    },
    "fixtures": [
      {
        "aliases": [
          "RGB",
          "rgb-fader",
          "RGB Fader"
        ],
        "modes": [
          {
            "key": "8bit",
            "name": "8 bit",
            "width": 3,
            "exact": true
          },
          {
            "key": "16bit",
            "name": "16 bit",
            "width": 6,
            "exact": true
          }
        ]
      },
      {
        "aliases": [
          "DeskCh",
          "desk-channel",
          "Desk Channel"
        ],
        "modes": [
          {
            "key": "8bit",
            "name": "8 bit",
            "width": 1,
            "exact": true
          }
        ]
      },
      {
        "aliases": [
          "Pixel Bar"
        ],
        "modes": [
          {
            "key": "Pixels",
            "name": "Pixels",
            "width": 30,
            "exact": false
          }
        ]
      }
    ],
    "expected": [
      {
        "path": [
          "artnet",
          "universes",
          0,
          "devices",
          1,
          "entity_id_prefix"
        ],
        "code": "duplicate",
        "severity": "error"
      },
      {
        "path": [
          "artnet",
          "universes",
          0,
          "devices",
          1,
          "start_address"
        ],
        "code": "overlap",
        "severity": "error"
      },
      {
        "path": [
          "artnet",
          "universes",
          0,
          "devices",
          2,
          "name"
        ],
        "code": "duplicate",
        "severity": "error"
      },
      {
        "path": [
          "artnet",
          "universes",
          1,
